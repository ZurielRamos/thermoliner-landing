      latam: [
        { code: "BR", es: "Brasil", en: "Brazil" },
        { code: "AR", es: "Argentina", en: "Argentina" },
        { code: "CL", es: "Chile", en: "Chile" },
        { code: "CO", es: "Colombia", en: "Colombia" },
        { code: "PE", es: "Perú", en: "Peru" },
        { code: "EC", es: "Ecuador", en: "Ecuador" },
        { code: "VE", es: "Venezuela", en: "Venezuela" },
        { code: "BO", es: "Bolivia", en: "Bolivia" },
        { code: "PY", es: "Paraguay", en: "Paraguay" },
        { code: "UY", es: "Uruguay", en: "Uruguay" },
        { code: "CR", es: "Costa Rica", en: "Costa Rica" },
        { code: "PA", es: "Panamá", en: "Panama" },
        { code: "GT", es: "Guatemala", en: "Guatemala" },
        { code: "DO", es: "Rep. Dominicana", en: "Dominican Rep." },
      ],
      eu: [
        { code: "ES", es: "España", en: "Spain" },
        { code: "PT", es: "Portugal", en: "Portugal" },
        { code: "FR", es: "Francia", en: "France" },
        { code: "GB", es: "Reino Unido", en: "United Kingdom" },
        { code: "IE", es: "Irlanda", en: "Ireland" },
        { code: "DE", es: "Alemania", en: "Germany" },
        { code: "IT", es: "Italia", en: "Italy" },
        { code: "NL", es: "Países Bajos", en: "Netherlands" },
        { code: "BE", es: "Bélgica", en: "Belgium" },
        { code: "CH", es: "Suiza", en: "Switzerland" },
        { code: "AT", es: "Austria", en: "Austria" },
        { code: "PL", es: "Polonia", en: "Poland" },
        { code: "SE", es: "Suecia", en: "Sweden" },
        { code: "NO", es: "Noruega", en: "Norway" },
        { code: "DK", es: "Dinamarca", en: "Denmark" },
        { code: "FI", es: "Finlandia", en: "Finland" },
      ],
    };

    // País -> región (para clic directo en el mapa)
    const COUNTRY_TO_REGION = {};
    Object.entries(REGIONS).forEach(([region, countries]) => {
      countries.forEach((c) => (COUNTRY_TO_REGION[c.code] = region));
    });

    const STORE_LINKS = {
      moto: { base: "https://thermolinerseats.com/es/" },
      util: { base: "https://thermolinerseats.com/en/" },
    };

    let currentStore = "moto";
    let view = "regions"; // "regions" | "countries"
    let activeRegion = null;
    let selectedCountry = null; // { code, region }
    let map = null;

    const lang = () => (window.__thermolinerLang && dict[window.__thermolinerLang] ? window.__thermolinerLang : "es");
    const tt = () => dict[lang()].modal;
    const countryName = (c) => (lang() === "en" ? c.en : c.es);

    const findCountry = (code) => {
      for (const list of Object.values(REGIONS)) {
        const found = list.find((c) => c.code === code);
        if (found) return found;
      }
      return null;
    };

    // ----- Pintado del mapa -----
    const FILL_ON = "#f24b28"; // naranja de acento
    const FILL_OFF = "#38424f"; // gris base (igual que regionStyle.initial)

    // Todos los códigos que manejamos, para poder resetearlos explícitamente
    const ALL_CODES = Object.values(REGIONS).flat().map((c) => c.code);

    // Colorea con hex directo por región usando la API de estilos de cada
    // shape: map.regions[code].element.setStyle('fill', color)
    const applyPaint = (onCodes) => {
      if (!map || !map.regions) return;
      const on = new Set(onCodes);
      ALL_CODES.forEach((code) => {
        const region = map.regions[code];
        if (!region || !region.element) return;
        try {
          region.element.setStyle("fill", on.has(code) ? FILL_ON : FILL_OFF);
        } catch (err) {
          /* región inexistente en el dataset del mapa */
        }
      });
    };

    const clearPaint = () => applyPaint([]);

    const paintRegion = (region) => {
      applyPaint((REGIONS[region] || []).map((c) => c.code));
    };

    const paintCountry = (code) => {
      applyPaint([code]);
    };

    // ----- Renderizado de la lista -----
    const renderRegions = () => {
      const m = tt();
      view = "regions";
      backBtn.hidden = true;
      listTitle.textContent = m.selectRegion;
      listEl.innerHTML = Object.keys(REGIONS)
        .map(
          (r) =>
            `<li><button type="button" class="region-item${activeRegion === r ? " is-selected" : ""}" role="option" data-region="${r}">${m.regions[r] || r}</button></li>`
        )
        .join("");
      listEl.querySelectorAll("[data-region]").forEach((btn) => {
        btn.addEventListener("click", () => enterRegion(btn.getAttribute("data-region")));
        btn.addEventListener("mouseenter", () => paintRegion(btn.getAttribute("data-region")));
      });
    };

    const renderCountries = (region) => {
      const m = tt();
      view = "countries";
      activeRegion = region;
      backBtn.hidden = false;
      backBtn.querySelector("[data-back-label]").textContent = m.back;
      listTitle.textContent = m.selectCountry + " · " + (m.regions[region] || region);
      listEl.innerHTML = (REGIONS[region] || [])
        .map(
          (c) =>
            `<li><button type="button" class="region-item${selectedCountry && selectedCountry.code === c.code ? " is-selected" : ""}" role="option" data-code="${c.code}">${countryName(c)}</button></li>`
        )
        .join("");
      listEl.querySelectorAll("[data-code]").forEach((btn) => {
        const code = btn.getAttribute("data-code");
        btn.addEventListener("click", () => selectCountry(code));
        btn.addEventListener("mouseenter", () => paintCountry(code));
      });
    };

    const restorePaint = () => {
      if (selectedCountry) paintCountry(selectedCountry.code);
      else if (view === "countries" && activeRegion) paintRegion(activeRegion);
      else clearPaint();
    };

    // ----- Acciones -----
    const enterRegion = (region) => {
      activeRegion = region;
      renderCountries(region); // primero la UI, para no depender del mapa
      paintRegion(region);
    };

    const goBack = () => {
      selectedCountry = null;
      updatePicked();
      goBtn.classList.remove("is-ready");
      goBtn.setAttribute("aria-disabled", "true");
      goBtn.removeAttribute("href");
      renderRegions();
      clearPaint();
    };

    const selectCountry = (code) => {
      const region = COUNTRY_TO_REGION[code];
      selectedCountry = { code, region };
      // Marca visualmente en la lista de países
      listEl.querySelectorAll("[data-code]").forEach((b) => {
        b.classList.toggle("is-selected", b.getAttribute("data-code") === code);
      });
      updatePicked();
      goBtn.classList.add("is-ready");
      goBtn.setAttribute("aria-disabled", "false");
      goBtn.href = `${STORE_LINKS[currentStore].base}?region=${region}&country=${code}`;
      goBtn.target = "_blank";
      goBtn.rel = "noopener noreferrer";
      paintCountry(code); // pintado al final: no debe bloquear la selección
    };

    const updatePicked = () => {
      const m = tt();
      if (selectedCountry) {
        const c = findCountry(selectedCountry.code);
        pickedLabel.textContent = m.selected;
        pickedValue.textContent = c ? countryName(c) : selectedCountry.code;
      } else {
        pickedLabel.textContent = m.none;
        pickedValue.textContent = "";
      }
    };

    // Clic en el mapa: si estamos en regiones, entra a la región del país;
    // si ya estamos en países de esa región, selecciona el país.
    const onMapClick = (code) => {
      const region = COUNTRY_TO_REGION[code];
      if (!region) return;
      if (view === "regions") {
        enterRegion(region);
      } else if (view === "countries") {
        if (region === activeRegion) selectCountry(code);
        else enterRegion(region);
      }
    };

    const refreshLabels = () => {
      const m = tt();
      titleEl.textContent = currentStore === "util" ? m.titleUtil : m.titleMoto;
      goBtn.querySelector("[data-i18n='modal.cta']").textContent = m.cta;
      updatePicked();
      if (view === "countries" && activeRegion) renderCountries(activeRegion);
      else renderRegions();
    };

    const initMap = () => {
      if (map || typeof window.jsVectorMap !== "function") return;
      map = new window.jsVectorMap({
        selector: mapEl,
        map: "world",
        zoomButtons: false,
        backgroundColor: "transparent",
        regionStyle: {
          initial: { fill: "#38424f", stroke: "#0f141b", strokeWidth: 0.4 },
          hover: { fill: "#f2854a" },
        },
        series: {
          regions: [
            {
              attribute: "fill",
              values: {},
            },
          ],
        },
        onRegionClick: (event, code) => onMapClick(code),
      });
    };

    const open = (store) => {
      currentStore = store;
      view = "regions";
      activeRegion = null;
      selectedCountry = null;
      goBtn.classList.remove("is-ready");
      goBtn.setAttribute("aria-disabled", "true");
      goBtn.removeAttribute("href");
      refreshLabels();

      modal.hidden = false;
      modal.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => {
        modal.classList.add("is-open");
        setTimeout(() => {
          initMap();
          if (map) {
            clearPaint();
            map.updateSize();
          }
        }, 60);
      });
      document.body.style.overflow = "hidden";
    };

    const close = () => {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      setTimeout(() => (modal.hidden = true), 320);
    };

    document.querySelectorAll("[data-open-store]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        open(btn.getAttribute("data-open-store"));
      });
    });

    backBtn.addEventListener("click", goBack);

    // Al salir de la lista, restaurar el pintado según el estado actual
    listEl.addEventListener("mouseleave", restorePaint);

    modal.querySelectorAll("[data-modal-close]").forEach((el) => el.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.hidden) close();
    });

    window.addEventListener("resize", () => {
      if (map && !modal.hidden) map.updateSize();
    });

    document.addEventListener("thermoliner:lang", refreshLabels);
  })();
</script>
