---
import { Image } from "astro:assets";
import logoDesktop from "../assets/logo_desktop.png";
import asiento1 from "../assets/asiento_1.png";
import asiento2 from "../assets/asiento_2.png";
import background1 from "../assets/background_1.png";
import background2 from "../assets/background_2.png";

// Diccionario de traducciones (se sirve al cliente para el cambio de idioma)
const i18n = {
  es: {
    langLabel: "ES",
    links: "Otros Enlaces",
    linksItems: [
      { label: "Sobre la empresa", href: "#" },
      { label: "Tecnología Thermoliner", href: "#" },
      { label: "Distribuidores", href: "#" },
      { label: "Soporte", href: "#" },
      { label: "Contacto", href: "#" },
    ],
    left: {
      eyebrow: "Tecnología Thermoliner",
      title: "Asientos para Motos",
      text: 'Asientos para <strong>moto</strong> con tecnología <strong class="accent">Thermoliner</strong>, que reduce la temperatura de la superficie <strong class="accent">hasta un 30%</strong>. Más confort en cada trayecto, incluso bajo el sol. Descubre la línea pensada para tu <strong>moto</strong> y entra a la tienda.',
      cta: "Entrar a la tienda de moto",
    },
    right: {
      eyebrow: "Tecnología Thermoliner",
      title: "Asientos Utilitarios",
      text: 'Asientos para <strong>landmowers</strong> y <strong>vehículos utilitarios</strong>, equipados con tecnología <strong class="accent">Thermoliner</strong> que baja la temperatura <strong class="accent">hasta un 30%</strong>. Jornadas largas de trabajo con el máximo confort y resistencia. Entra a la tienda para tu <strong>vehículo utilitario</strong>.',
      cta: "Entrar a la tienda utilitaria",
    },
    modal: {
      eyebrow: "Selecciona tu región",
      titleMoto: "Tienda de Motos",
      titleUtil: "Tienda Utilitaria",
      subtitle: "Elige tu región y luego tu país para llevarte a la tienda correcta.",
      selectRegion: "Selecciona una región",
      selectCountry: "Selecciona tu país",
      back: "Volver a regiones",
      selected: "País seleccionado",
      none: "Ningún país seleccionado",
      cta: "Ir a la tienda",
      close: "Cerrar",
      regions: {
        na: "Norteamérica",
        latam: "Latinoamérica",
        eu: "Europa",
      },
    },
  },
  en: {
    langLabel: "EN",
    links: "Other Links",
    linksItems: [
      { label: "About us", href: "#" },
      { label: "Thermoliner Technology", href: "#" },
      { label: "Dealers", href: "#" },
      { label: "Support", href: "#" },
      { label: "Contact", href: "#" },
    ],
    left: {
      eyebrow: "Thermoliner Technology",
      title: "Motorcycle Seats",
      text: '<strong>Motorcycle</strong> seats featuring <strong class="accent">Thermoliner</strong> technology, which lowers the surface temperature by <strong class="accent">up to 30%</strong>. More comfort on every ride, even under the sun. Discover the line built for your <strong>motorcycle</strong> and enter the store.',
      cta: "Enter the motorcycle store",
    },
    right: {
      eyebrow: "Thermoliner Technology",
      title: "Utility Seats",
      text: 'Seats for <strong>landmowers</strong> and <strong>utility vehicles</strong>, equipped with <strong class="accent">Thermoliner</strong> technology that lowers the temperature <strong class="accent">by up to 30%</strong>. Long work shifts with maximum comfort and durability. Enter the store for your <strong>utility vehicle</strong>.',
      cta: "Enter the utility store",
    },
    modal: {
      eyebrow: "Select your region",
      titleMoto: "Motorcycle Store",
      titleUtil: "Utility Store",
      subtitle: "Pick your region and then your country to take you to the right store.",
      selectRegion: "Select a region",
      selectCountry: "Select your country",
      back: "Back to regions",
      selected: "Selected country",
      none: "No country selected",
      cta: "Go to store",
      close: "Close",
      regions: {
        na: "North America",
        latam: "Latin America",
        eu: "Europe",
      },
    },
  },
};

// Idioma por defecto para el render inicial (SSG)
const t = i18n.es;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Thermoliner Seats</title>
    <!-- jsVectorMap: mapa mundial interactivo -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsvectormap@1.7.0/dist/jsvectormap.min.css" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/jsvectormap@1.7.0/dist/jsvectormap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/jsvectormap@1.7.0/dist/maps/world.js"></script>
  </head>
  <body>
    <main class="landing">
      <!-- Header global -->
      <header class="topbar">
        <a href="/" class="logo" aria-label="Thermoliner Seats">
          <Image src={logoDesktop} alt="Thermoliner Seats" widths={[220, 320]} sizes="220px" />
        </a>
        <nav class="actions">
          <!-- Dropdown de enlaces -->
          <div class="menu" data-menu="links">
            <button type="button" class="pill" aria-haspopup="true" aria-expanded="false" data-menu-toggle>
              <span data-i18n="links">{t.links}</span>
              <svg class="pill__caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <ul class="dropdown" role="menu" data-links-list>
              {t.linksItems.map((item) => (
                <li role="none"><a role="menuitem" href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>

          <!-- Selector de idioma -->
          <div class="menu" data-menu="lang">
            <button type="button" class="pill" aria-haspopup="true" aria-expanded="false" aria-label="Cambiar idioma" data-menu-toggle>
              <span data-lang-label>{t.langLabel}</span>
              <svg class="pill__caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <ul class="dropdown dropdown--lang" role="menu">
              <li role="none"><button role="menuitem" type="button" class="lang-option" data-lang="es">Español</button></li>
              <li role="none"><button role="menuitem" type="button" class="lang-option" data-lang="en">English</button></li>
            </ul>
          </div>
        </nav>
      </header>

      <!-- Panel izquierdo -->
      <section class="panel panel--left">
        <Image class="panel__bg" src={background1} alt="" widths={[720, 1080]} sizes="50vw" />
        <span class="panel__overlay" aria-hidden="true"></span>
        <div class="panel__content">
          <hgroup class="panel__heading panel__heading--left">
            <p class="panel__eyebrow" data-i18n="left.eyebrow">{t.left.eyebrow}</p>
            <h1 class="panel__title panel__title--left" data-i18n="left.title">{t.left.title}</h1>
          </hgroup>
          <Image class="panel__product panel__product--left" src={asiento1} alt="Asiento de moto con tecnología Thermoliner" widths={[520, 780]} sizes="(max-width: 900px) 90vw, 45vw" />
          <p class="panel__text panel__text--left" data-i18n-html="left.text" set:html={t.left.text}></p>
          <a href="#" class="cta" data-i18n="left.cta" data-open-store="moto">{t.left.cta}</a>
        </div>
      </section>

      <!-- Panel derecho -->
      <section class="panel panel--right">
        <Image class="panel__bg" src={background2} alt="" widths={[720, 1080]} sizes="50vw" />
        <span class="panel__overlay" aria-hidden="true"></span>
        <div class="panel__content">
          <div class="panel__copy">
            <p class="panel__eyebrow" data-i18n="right.eyebrow">{t.right.eyebrow}</p>
            <h2 class="panel__title panel__title--right" data-i18n="right.title">{t.right.title}</h2>
            <p class="panel__text panel__text--right" data-i18n-html="right.text" set:html={t.right.text}></p>
          </div>
          <Image class="panel__product panel__product--right" src={asiento2} alt="Asiento para vehículo utilitario con tecnología Thermoliner" widths={[520, 780]} sizes="(max-width: 900px) 90vw, 45vw" />
          <a href="#" class="cta" data-i18n="right.cta" data-open-store="util">{t.right.cta}</a>
        </div>
      </section>

      <!-- Divisor central -->
      <div class="divider" aria-hidden="true">
        <span class="divider__star"></span>
      </div>
    </main>

    <!-- Modal selección de región -->
    <div class="modal" data-modal hidden aria-hidden="true">
      <div class="modal__overlay" data-modal-close></div>
      <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <button type="button" class="modal__close" data-modal-close aria-label="Cerrar" data-modal-close-label>&times;</button>

        <div class="modal__head">
          <p class="modal__eyebrow" data-i18n="modal.eyebrow">{t.modal.eyebrow}</p>
          <h2 class="modal__title" id="modal-title" data-modal-title>{t.modal.titleMoto}</h2>
          <p class="modal__subtitle" data-i18n="modal.subtitle">{t.modal.subtitle}</p>
        </div>

        <div class="modal__body">
          <!-- Mapa mundial interactivo (jsVectorMap) -->
          <div class="modal__map">
            <div class="worldmap" data-worldmap></div>
          </div>

          <!-- Panel de selección (regiones -> países) -->
          <div class="modal__side">
            <div class="list-head">
              <button type="button" class="list-back" data-list-back hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span data-back-label>{t.modal.back}</span>
              </button>
              <p class="list-head__title" data-list-title>{t.modal.selectRegion}</p>
            </div>

            <ul class="region-list" role="listbox" aria-label="Selección" data-select-list></ul>

            <div class="modal__footer">
              <p class="modal__picked">
                <span class="modal__picked-label">{t.modal.none}</span>
                <span class="modal__picked-value" data-picked-value></span>
              </p>
              <a class="cta modal__cta" data-modal-go href="#" aria-disabled="true">
                <span data-i18n="modal.cta">{t.modal.cta}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Cursor personalizado: anillo (honda) + punto -->
    <div class="cursor" aria-hidden="true">
      <span class="cursor__ring"></span>
      <span class="cursor__dot"></span>
    </div>

    <!-- Datos de traducción para el cambio de idioma en cliente -->
    <script type="application/json" id="i18n-data" set:html={JSON.stringify(i18n)}></script>
  </body>
</html>

<style>
  :root {
    --accent: #f24b28;
    --text: #ffffff;
    --text-muted: #c7cdd6;
    /* Alto real del viewport: se recalcula por JS con fallback a 1vh */
    --vh: 1vh;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: #0d1117;
    color: var(--text);
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    overflow: hidden;
  }

  .landing {
    position: relative;
    display: flex;
    height: 100vh;
    height: calc(var(--vh, 1vh) * 100);
    height: 100dvh;
    width: 100%;
    overflow: hidden;
  }

  /* ---------- Header ---------- */
  .topbar {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(0.8rem, 2.4vh, 1.6rem) clamp(1.2rem, 3vw, 2.5rem);
    pointer-events: none;
  }

  .logo,
  .actions {
    pointer-events: auto;
  }

  .logo img {
    display: block;
    height: clamp(22px, 4.2vh, 38px);
    width: auto;
  }

  .actions {
    display: flex;
    gap: clamp(0.4rem, 1vw, 0.75rem);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: clamp(0.4rem, 1.1vh, 0.6rem) clamp(0.9rem, 1.6vw, 1.3rem);
    border: none;
    border-radius: 999px;
    background: #f2efe9;
    color: #1a1f26;
    font-size: clamp(0.75rem, 1.6vh, 0.9rem);
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .pill:hover {
    background: #ffffff;
    transform: translateY(-1px);
  }

  .pill {
    gap: 0.45rem;
  }

  .pill__caret {
    transition: transform 0.25s ease;
  }

  .menu[data-open="true"] .pill__caret {
    transform: rotate(180deg);
  }

  /* ---------- Menú desplegable ---------- */
  .menu {
    position: relative;
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    min-width: 220px;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top right;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 30;
  }

  .dropdown--lang {
    min-width: 150px;
  }

  .menu[data-open="true"] .dropdown {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .dropdown :global(li) {
    margin: 0;
    list-style: none;
  }

  .dropdown :global(a),
  .dropdown :global(.lang-option) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: #1a1f26;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease, padding-left 0.18s ease;
  }

  .dropdown :global(a:hover),
  .dropdown :global(.lang-option:hover) {
    background: #f4f1ea;
    color: #000000;
    padding-left: 1.1rem;
  }

  /* Separadores sutiles entre elementos (menos el último) */
  .dropdown :global(li:not(:last-child) a),
  .dropdown :global(li:not(:last-child) .lang-option) {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 0;
  }

  .dropdown :global(li:not(:last-child) a:hover),
  .dropdown :global(li:not(:last-child) .lang-option:hover) {
    border-radius: 10px;
  }

  .dropdown :global(.lang-option[aria-current="true"]) {
    color: var(--accent);
  }

  /* ---------- Paneles ---------- */
  .panel {
    position: relative;
    flex: 1 1 50%;
    min-height: 0;
    overflow: hidden;
    transition: flex-grow 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Estado activo / inactivo */
  .panel.is-active {
    flex-grow: 1.12;
  }

  .panel.is-inactive {
    flex-grow: 0.88;
  }

  .panel__overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: #05070b;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  .panel.is-inactive .panel__overlay {
    opacity: 0.42;
  }

  .panel__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .panel.is-active .panel__bg {
    transform: scale(1.04);
  }

  /* --- Cambios sutiles de imagen y texto según activo/inactivo --- */

  /* Activo: la imagen se agranda un poco y se realza */
  .panel.is-active .panel__product {
    transform: scale(1.06);
    filter: drop-shadow(0 34px 46px rgba(0, 0, 0, 0.6)) brightness(1.04);
  }

  .panel.is-active .panel__eyebrow,
  .panel.is-active .panel__title,
  .panel.is-active .panel__text {
    opacity: 1;
    transform: translateY(0);
  }

  /* En la sección activa, el botón se vuelve blanco con texto oscuro */
  .panel.is-active .cta {
    background: #ffffff;
    border-color: #ffffff;
    color: #12161c;
  }

  .panel.is-active .cta:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  /* Inactivo: imagen ligeramente reducida y texto atenuado que sube apenas */
  .panel.is-inactive .panel__product {
    transform: scale(0.94);
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.45)) brightness(0.9) saturate(0.9);
  }

  .panel.is-inactive .panel__eyebrow {
    opacity: 0.55;
    transform: translateY(-4px);
  }

  .panel.is-inactive .panel__title {
    opacity: 0.72;
    transform: translateY(-4px);
  }

  .panel.is-inactive .panel__text {
    opacity: 0.55;
    transform: translateY(4px);
  }

  .panel__content {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    display: grid;
    padding: clamp(3.5rem, 9vh, 6rem) clamp(2rem, 4vw, 4rem) clamp(2rem, 5vh, 3.5rem);
  }

  /* Panel izquierdo: título, imagen y texto agrupados y centrados
     (título cerca del asiento por arriba, texto cerca por abajo),
     botón anclado abajo (ancho). */
  .panel--left .panel__content {
    grid-template-columns: 1fr;
    grid-template-rows: 1fr auto auto auto 1fr auto;
    grid-template-areas:
      "."
      "title"
      "product"
      "text"
      "."
      "cta";
    row-gap: clamp(0.5rem, 1.6vh, 1rem);
    justify-items: start;
    text-align: left;
  }

  /* Panel derecho: copy (izquierda) e imagen (derecha) en la MISMA banda,
     título arriba en una sola línea, botón anclado abajo (ancho). */
  .panel--right .panel__content {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-rows: 1fr auto;
    grid-template-areas:
      "copy    product"
      "cta     cta";
    column-gap: clamp(0.5rem, 2vw, 1.5rem);
    row-gap: clamp(0.8rem, 2.5vh, 1.6rem);
    align-items: center;
    text-align: left;
  }

  /* Bloque de encabezado (eyebrow + título) del panel izquierdo */
  .panel__heading--left {
    grid-area: title;
    margin: 0;
    justify-self: end;
    text-align: right;
    max-width: 72%;
  }

  /* Subtítulo (eyebrow) sobre el título */
  .panel__eyebrow {
    margin: 0 0 clamp(0.35rem, 1.1vh, 0.7rem);
    font-size: clamp(0.68rem, 1.5vh, 0.9rem);
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .panel__title {
    margin: 0;
    font-size: clamp(1.5rem, 4.6vh, 3rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0.5px;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .panel__title--left {
    text-align: right;
  }

  .panel__copy {
    grid-area: copy;
    align-self: center;
  }

  .panel__title--right {
    margin-bottom: clamp(1.8rem, 5.5vh, 3.2rem);
    white-space: nowrap;
  }

  .panel__text {
    margin: 0;
    font-size: clamp(0.76rem, 1.85vh, 1.15rem);
    line-height: 1.6;
    color: var(--text-muted);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Resaltados dentro del párrafo */
  .panel__text strong {
    color: var(--text);
    font-weight: 700;
  }

  .panel__text strong.accent {
    color: var(--accent);
    font-weight: 800;
  }

  .panel__text--left {
    grid-area: text;
    max-width: 62%;
    align-self: end;
  }

  .panel__product {
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.55));
    grid-area: product;
    align-self: center;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s ease;
  }

  /* La imagen izquierda escala con la pantalla, centrada en su banda */
  .panel__product--left {
    justify-self: center;
    width: auto;
    max-width: 100%;
    max-height: clamp(150px, 40vh, 440px);
  }

  /* La imagen derecha es grande y se pega al borde derecho, desbordando */
  .panel__product--right {
    justify-self: end;
    align-self: center;
    width: auto;
    max-width: 122%;
    max-height: clamp(180px, 52vh, 520px);
    margin-right: clamp(-2rem, -5vw, -5rem);
  }

  /* ---------- Botón CTA ---------- */
  .cta {
    grid-area: cta;
    justify-self: stretch;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.75rem, 1.8vh, 1.05rem) clamp(1.6rem, 3vw, 2.5rem);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font-size: clamp(0.82rem, 1.7vh, 1rem);
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.35s ease, border-color 0.35s ease, color 0.35s ease, transform 0.2s ease;
  }

  .cta:hover {
    background: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  /* ---------- Divisor central ---------- */
  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
